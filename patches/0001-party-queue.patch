+import { strict as assert } from "node:assert";
+import { test } from "node:test";
+
+import {
+  QUEUE_COMMAND_BURST,
+  TokenBucket,
+  classifyMessage,
+  featuresFor,
+  handshakeFields,
+  normalizeParticipantId,
+  parseMaxMessageBytes,
+  parseQueueEnabled,
+  utf8ByteLength,
+  withServerSender,
+} from "../src/routing.js";
+
+test("host broadcast types go to everyone", () => {
+  for (const type of [
+    "party_config",
+    "party_members",
+    "queue_patch",
+    "set_control_mode",
+    "sync_state",
+    "heartbeat",
+  ]) {
+    assert.deepEqual(classifyMessage(type, "host", true), { action: "broadcast", type });
+  }
+});
+
+test("host queue_snapshot and queue_ack broadcast without to", () => {
+  for (const type of ["queue_snapshot", "queue_ack"]) {
+    assert.deepEqual(classifyMessage(type, "host", true), { action: "broadcast", type });
+    assert.deepEqual(classifyMessage(type, "host", true, null), {
+      action: "broadcast",
+      type,
+    });
+  }
+});
+
+test("host queue_snapshot and queue_ack target one guest when to is set", () => {
+  assert.deepEqual(classifyMessage("queue_snapshot", "host", true, " p-7f3a "), {
+    action: "to_guest",
+    type: "queue_snapshot",
+    to: "p-7f3a",
+  });
+  assert.deepEqual(classifyMessage("queue_ack", "host", true, "p-7f3a"), {
+    action: "to_guest",
+    type: "queue_ack",
+    to: "p-7f3a",
+  });
+});
+
+test("a malformed to is dropped instead of broadcast", () => {
+  for (const to of ["", "   ", 42, {}, "bad id", "x".repeat(65)]) {
+    assert.deepEqual(classifyMessage("queue_snapshot", "host", true, to), {
+      action: "drop",
+      type: "queue_snapshot",
+      reason: "invalid_target",
+    });
+  }
+});
+
+test("guests send queue and playback messages only to the host", () => {
+  for (const type of ["queue_command", "queue_resync", "playback_command"]) {
+    assert.deepEqual(classifyMessage(type, "guest", true), { action: "to_host", type });
+  }
+});
+
+test("queue messages from the wrong role are dropped", () => {
+  for (const type of ["queue_patch", "queue_snapshot", "queue_ack", "party_config"]) {
+    assert.deepEqual(classifyMessage(type, "guest", true), {
+      action: "drop",
+      type,
+      reason: "wrong_role",
+    });
+  }
+  for (const type of ["queue_command", "queue_resync", "playback_command"]) {
+    assert.deepEqual(classifyMessage(type, "host", true), {
+      action: "drop",
+      type,
+      reason: "wrong_role",
+    });
+  }
+});
+
+test("QUEUE_ENABLED=0 removes queue_* but keeps Listening Party v1", () => {
+  for (const type of ["queue_patch", "queue_snapshot", "queue_command", "queue_resync"]) {
+    const role = type === "queue_command" || type === "queue_resync" ? "guest" : "host";
+    assert.deepEqual(classifyMessage(type, role, false), {
+      action: "drop",
+      type,
+      reason: "queue_disabled",
+    });
+  }
+  assert.deepEqual(classifyMessage("sync_state", "host", false), {
+    action: "broadcast",
+    type: "sync_state",
+  });
+  assert.deepEqual(classifyMessage("playback_command", "guest", false), {
+    action: "to_host",
+    type: "playback_command",
+  });
+});
+
+test("unknown client messages are dropped without closing anything", () => {
+  assert.deepEqual(classifyMessage("error", "host", true), {
+    action: "drop",
+    type: "error",
+    reason: "unknown_type",
+  });
+  assert.deepEqual(classifyMessage("guest_joined", "guest", true), {
+    action: "drop",
+    type: "guest_joined",
+    reason: "unknown_type",
+  });
+  assert.deepEqual(classifyMessage(undefined, "guest", true), {
+    action: "drop",
+    type: "",
+    reason: "unknown_type",
+  });
+});
+
+test("withServerSender discards the client's from/from_id", () => {
+  const incoming = {
+    type: "queue_command",
+    op_id: "a1",
+    from: "mallory",
+    from_id: "p-evil",
+  };
+  const outgoing = withServerSender(incoming, { id: "p-7f3a", name: "ana" });
+  assert.equal(outgoing.type, "queue_command");
+  assert.equal(outgoing.op_id, "a1");
+  assert.equal(outgoing.from, "ana");
+  assert.equal(outgoing.from_id, "p-7f3a");
+  assert.equal(incoming.from, "mallory");
+  assert.equal(incoming.from_id, "p-evil");
+});
+
+test("withServerSender also stamps queue_resync", () => {
+  const outgoing = withServerSender(
+    { type: "queue_resync", have_revision: 40 },
+    { id: "p-7f3a", name: "ana" },
+  );
+  assert.equal(outgoing.from, "ana");
+  assert.equal(outgoing.from_id, "p-7f3a");
+});
+
+test("token bucket allows a burst of ten and refills at two per second", () => {
+  const bucket = new TokenBucket(QUEUE_COMMAND_BURST, 2, 0);
+  for (let i = 0; i < QUEUE_COMMAND_BURST; i++) {
+    assert.equal(bucket.tryTake(0), true, `burst take ${i}`);
+  }
+  assert.equal(bucket.tryTake(0), false);
+  assert.equal(bucket.tryTake(499), false);
+  assert.equal(bucket.tryTake(500), true);
+  assert.equal(bucket.tryTake(500), false);
+  assert.equal(bucket.tryTake(1000), true);
+  assert.equal(bucket.tryTake(1000), false);
+});
+
+test("token bucket never refills past the burst", () => {
+  const bucket = new TokenBucket(10, 2, 0);
+  for (let i = 0; i < 10; i++) assert.equal(bucket.tryTake(0), true);
+  assert.equal(bucket.available, 0);
+  assert.equal(bucket.tryTake(60_000), true);
+  assert.equal(bucket.available, 9);
+});
+
+test("participant ids are trimmed and kept to the relay's shape", () => {
+  assert.equal(normalizeParticipantId(" host "), "host");
+  assert.equal(
+    normalizeParticipantId("7f3a2c9e-1b4d-4e8a-9c0f-123456789abc"),
+    "7f3a2c9e-1b4d-4e8a-9c0f-123456789abc",
+  );
+  assert.equal(normalizeParticipantId(""), null);
+  assert.equal(normalizeParticipantId("bad id"), null);
+  assert.equal(normalizeParticipantId("x".repeat(65)), null);
+  assert.equal(normalizeParticipantId("bad\u0000id"), null);
+});
+
+test("MAX_MESSAGE_BYTES parses env values and falls back safely", () => {
+  assert.equal(parseMaxMessageBytes(undefined), 4096);
+  assert.equal(parseMaxMessageBytes(""), 4096);
+  assert.equal(parseMaxMessageBytes("8192"), 8192);
+  assert.equal(parseMaxMessageBytes("512"), 512);
+  for (const invalid of ["abc", "0", "1.5", "-1", "999999999"]) {
+    assert.equal(parseMaxMessageBytes(invalid), 4096, invalid);
+  }
+});
+
+test("QUEUE_ENABLED parses off values", () => {
+  assert.equal(parseQueueEnabled(undefined), true);
+  assert.equal(parseQueueEnabled("1"), true);
+  assert.equal(parseQueueEnabled("true"), true);
+  for (const off of ["0", "false", "FALSE", "off", "no", "disabled"]) {
+    assert.equal(parseQueueEnabled(off), false, off);
+  }
+});
+
+test("handshake advertises protocol v2 and the queue feature", () => {
+  assert.deepEqual(featuresFor(true), ["queue"]);
+  assert.deepEqual(featuresFor(false), []);
+  assert.deepEqual(handshakeFields(true), {
+    protocol_version: 2,
+    features: ["queue"],
+    playback_mode: "follow_host",
+    queue_revision: 0,
+  });
+  assert.deepEqual(handshakeFields(false), {
+    protocol_version: 2,
+    features: [],
+    playback_mode: "follow_host",
+    queue_revision: 0,
+  });
+});
+
+test("size is measured in UTF-8 bytes, not UTF-16 code units", () => {
+  assert.equal(utf8ByteLength("abc"), 3);
+  assert.equal(utf8ByteLength("é"), 2);
+  assert.equal(utf8ByteLength("漢"), 3);
+  assert.equal(utf8ByteLength("🎵"), 4);
+  assert.equal("🎵".length, 2);
+});
