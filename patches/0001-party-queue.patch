+/// The relay drops frames larger than this; snapshots must be packed below it.
+pub const MAX_RELAY_MESSAGE_BYTES: usize = 4_096;
+/// Leave headroom for JSON escaping and for the `to` field the relay adds.
+pub const SNAPSHOT_BUDGET_BYTES: usize = 3_500;
+
+/// Pack a queue snapshot into relay-sized frames.
+///
+/// The split is by serialized size, not by a fixed item count: a 120-character
+/// CJK title costs more bytes than a short ASCII one. Every returned message is
+/// a complete `queue_snapshot` sharing `snapshot_id` and `revision`.
+pub fn queue_snapshot_messages(snapshot: &PartyQueueSnapshot) -> Vec<SyncMessage> {
+  let mut groups: Vec<Vec<_>> = Vec::new();
+  let mut current = Vec::new();
+  for item in &snapshot.items {
+    current.push(item.clone());
+    let probe = PartyQueueSnapshot {
+      chunk: 0,
+      chunks: 1,
+      items: current.clone(),
+      ..snapshot.clone()
+    };
+    let fits = serde_json::to_string(&SyncMessage::QueueSnapshot(probe))
+      .map(|json| json.len() <= SNAPSHOT_BUDGET_BYTES)
+      .unwrap_or(false);
+    if !fits && current.len() > 1 {
+      let last = current.pop().expect("just pushed");
+      groups.push(std::mem::take(&mut current));
+      current.push(last);
+    }
+  }
+  if !current.is_empty() || groups.is_empty() {
+    groups.push(current);
+  }
+
+  let chunks = groups.len().min(u16::MAX as usize) as u16;
+  groups
+    .into_iter()
+    .enumerate()
+    .map(|(index, items)| {
+      SyncMessage::QueueSnapshot(PartyQueueSnapshot {
+        chunk: index as u16,
+        chunks,
+        items,
+        ..snapshot.clone()
+      })
+    })
+    .collect()
+}
