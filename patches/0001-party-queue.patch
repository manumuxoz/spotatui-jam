new file mode 100644
index 0000000..3b5d0d3
--- /dev/null
+++ b/worker-relay/src/routing.ts
@@ -0,0 +1,225 @@
+/**
+ * Pure routing policy for the Spotatui party relay.
+ *
+ * Nothing in this module touches Cloudflare, WebSockets or timers, so the
+ * direction matrix, target handling and sender sanitizing can be tested with
+ * plain Node. `index.ts` owns the sockets and translates a decision into a
+ * send or a drop.
+ */
+
+export type PartyRole = "host" | "guest";
+
+export type DropReason =
+  | "unknown_type"
+  | "wrong_role"
+  | "queue_disabled"
+  | "invalid_target";
+
+export type RouteDecision =
+  | { action: "broadcast"; type: string }
+  | { action: "to_guest"; type: string; to: string }
+  | { action: "to_host"; type: string }
+  | { action: "drop"; type: string; reason: DropReason };
+
+export const HOST_ID = "host";
+export const DEFAULT_MAX_MESSAGE_BYTES = 4 * 1024;
+export const MIN_MAX_MESSAGE_BYTES = 512;
+export const MAX_MAX_MESSAGE_BYTES = 1024 * 1024;
+export const QUEUE_COMMAND_BURST = 10;
+export const QUEUE_COMMAND_REFILL_PER_SECOND = 2;
+
+// Host -> everyone. The relay is a dumb pipe for the queue itself.
+const HOST_BROADCAST_TYPES = new Set([
+  "party_config",
+  "party_members",
+  "queue_patch",
+  "set_control_mode",
+  "sync_state",
+  "heartbeat",
+]);
+
+// Host -> everyone, or host -> one guest when `to` names that guest.
+const HOST_DIRECTED_TYPES = new Set(["queue_snapshot", "queue_ack"]);
+
+// Guest -> host message types. `playback_command` additionally needs
+// shared_control, which the room enforces because it owns that state.
+const GUEST_TO_HOST_TYPES = new Set([
+  "queue_command",
+  "queue_resync",
+  "playback_command",
+]);
+
+/** Queue messages are the `queue_*` family; disabling them leaves v1 intact. */
+export function isQueueType(type: string): boolean {
+  return type.startsWith("queue_");
+}
+
+/**
+ * Decide where a client message goes.
+ *
+ * `to` is only consulted for the host-directed types. A non-string or empty
+ * target is invalid, while an absent/null target means broadcast. Resolving
+ * the target id to a live guest happens in `index.ts`, where the sessions
+ * live; an unknown id is dropped there.
+ */
+export function classifyMessage(
+  type: unknown,
+  role: PartyRole,
+  queueEnabled: boolean,
+  to?: unknown,
+): RouteDecision {
+  if (typeof type !== "string" || type.length === 0) {
+    return { action: "drop", type: "", reason: "unknown_type" };
+  }
+
+  if (!queueEnabled && isQueueType(type)) {
+    return { action: "drop", type, reason: "queue_disabled" };
+  }
+
+  if (HOST_BROADCAST_TYPES.has(type)) {
+    return role === "host"
+      ? { action: "broadcast", type }
+      : { action: "drop", type, reason: "wrong_role" };
+  }
+
+  if (HOST_DIRECTED_TYPES.has(type)) {
+    if (role !== "host") {
+      return { action: "drop", type, reason: "wrong_role" };
+    }
+    if (to === undefined || to === null) {
+      return { action: "broadcast", type };
+    }
+    if (typeof to !== "string") {
+      return { action: "drop", type, reason: "invalid_target" };
+    }
+    const target = normalizeParticipantId(to);
+    if (target === null) {
+      return { action: "drop", type, reason: "invalid_target" };
+    }
+    return { action: "to_guest", type, to: target };
+  }
+
+  if (GUEST_TO_HOST_TYPES.has(type)) {
+    return role === "guest"
+      ? { action: "to_host", type }
+      : { action: "drop", type, reason: "wrong_role" };
+  }
+
+  return {
+    action: "drop",
+    type,
+    reason: isQueueType(type) || type.startsWith("party_") ? "wrong_role" : "unknown_type",
+  };
+}
+
+/**
+ * Participant ids are relay-generated UUIDs, or the literal `host`. Keeping
+ * the accepted shape narrow stops a host from addressing arbitrary strings.
+ */
+export function normalizeParticipantId(value: string): string | null {
+  const id = value.trim();
+  if (id.length === 0 || id.length > 64) return null;
+  if (!/^[A-Za-z0-9._:-]+$/.test(id)) return null;
+  return id;
+}
+
+/** Copy a guest message with the relay's identity, discarding the client's. */
+export function withServerSender(
+  message: Record<string, unknown>,
+  sender: { id: string; name: string },
+): Record<string, unknown> {
+  const copy: Record<string, unknown> = { ...message };
+  delete copy.from;
+  delete copy.from_id;
+  copy.from = sender.name;
+  copy.from_id = sender.id;
+  return copy;
+}
+
+/** The `features` array advertised in the handshake. */
+export function featuresFor(queueEnabled: boolean): string[] {
+  return queueEnabled ? ["queue"] : [];
+}
+
+/** Handshake fields every v2 relay adds to `room_created` / `joined_room`. */
+export function handshakeFields(queueEnabled: boolean): {
+  protocol_version: 2;
+  features: string[];
+  playback_mode: "follow_host";
+  queue_revision: 0;
+} {
+  return {
+    protocol_version: 2,
+    features: featuresFor(queueEnabled),
+    playback_mode: "follow_host",
+    queue_revision: 0,
+  };
+}
+
+/** UTF-8 size, which is the protocol's size unit; JS `.length` is UTF-16. */
+const encoder = new TextEncoder();
+
+export function utf8ByteLength(text: string): number {
+  return encoder.encode(text).length;
+}
+
+/**
+ * `MAX_MESSAGE_BYTES` comes from `env`/`[vars]`. Invalid or out-of-range
+ * values fall back to the protocol default instead of failing requests.
+ */
+export function parseMaxMessageBytes(
+  value: string | undefined,
+  fallback: number = DEFAULT_MAX_MESSAGE_BYTES,
+): number {
+  if (value === undefined || value.trim() === "") return fallback;
+  const parsed = Number(value);
+  if (
+    !Number.isInteger(parsed) ||
+    parsed < MIN_MAX_MESSAGE_BYTES ||
+    parsed > MAX_MAX_MESSAGE_BYTES
+  ) {
+    return fallback;
+  }
+  return parsed;
+}
+
+/** `QUEUE_ENABLED=0` degrades the relay to a Listening Party relay. */
+export function parseQueueEnabled(value: string | undefined): boolean {
+  if (value === undefined) return true;
+  return !["0", "false", "off", "no", "disabled"].includes(value.trim().toLowerCase());
+}
+
+/**
+ * Per-session token bucket for `queue_command`. The room owns one per session;
+ * this class has no clock so tests can drive it deterministically.
+ */
+export class TokenBucket {
+  private tokens: number;
+  private lastRefillMs: number;
+
+  constructor(
+    private readonly burst: number = QUEUE_COMMAND_BURST,
+    private readonly refillPerSecond: number = QUEUE_COMMAND_REFILL_PER_SECOND,
+    nowMs: number = 0,
+  ) {
+    this.tokens = burst;
+    this.lastRefillMs = nowMs;
+  }
+
+  tryTake(nowMs: number): boolean {
+    const now = Math.max(nowMs, this.lastRefillMs);
+    const elapsedMs = now - this.lastRefillMs;
+    this.tokens = Math.min(
+      this.burst,
+      this.tokens + (elapsedMs * this.refillPerSecond) / 1000,
+    );
+    this.lastRefillMs = now;
+    if (this.tokens < 1) return false;
+    this.tokens -= 1;
+    return true;
+  }
+
+  get available(): number {
+    return this.tokens;
+  }
+}
