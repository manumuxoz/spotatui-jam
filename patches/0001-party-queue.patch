+  pub fn party_queue(&self) -> &crate::core::party::PartyQueue {
+    &self.party_queue
+  }
+
+  pub(crate) fn party_queue_mut(&mut self) -> &mut crate::core::party::PartyQueue {
+    &mut self.party_queue
+  }
+
+  pub(crate) fn reset_party_queue(&mut self) {
+    self.party_queue = crate::core::party::PartyQueue::default();
+    self.display_revisions.bump(DisplayDomain::Queue);
+  }
+
+  pub(crate) fn party_is_active(&self) -> bool {
+    self.party_session.is_some()
+  }
+
+  pub fn party_is_host(&self) -> bool {
+    self
+      .party_session
+      .as_ref()
+      .is_some_and(|session| session.role == PartyRole::Host)
+  }
+
+  /// Start the host queue from what is playing and what is already queued.
+  pub(crate) fn start_party_queue(&mut self) {
+    let host_name = self
+      .party_session
+      .as_ref()
+      .map(|session| session.host_name.clone())
+      .filter(|name| !name.is_empty())
+      .unwrap_or_else(|| "Host".to_string());
+    let host = crate::core::party::PartyMember::host(host_name);
+    let mut queue = crate::core::party::PartyQueue::with_host(Default::default(), host.clone());
+    let current = crate::core::plugin_api::playback_state(self).and_then(|state| state.track);
+    let queued = self.native_queue.clone();
+    queue.adopt(&host, current.as_ref(), &queued, party_now_ms());
+    queue.set_members(vec![host]);
+    self.party_queue = queue;
+    self.project_party_queue();
+  }
+
+  /// Replace the playable native queue with the party queue's upcoming items.
+  pub(crate) fn project_party_queue(&mut self) {
+    self.native_queue = self.party_queue.projected_tracks();
+  }
+
+  /// Record a playback transition into the party queue, returning the op a
+  /// host must broadcast. Guests never call this.
+  pub(crate) fn observe_party_playback(&mut self) -> Option<crate::core::party::QueueOp> {
+    let uri = crate::core::plugin_api::playback_state(self)
+      .and_then(|state| state.track)
+      .and_then(|track| track.uri)?;
+    let op = self.party_queue.observe_playback(&uri, party_now_ms())?;
+    self.project_party_queue();
+    Some(op)
+  }
+
+  /// Resolve a queue-screen row (URI + position) to the party item id.
+  pub(crate) fn party_item_id(&self, uri: &str, position: usize) -> Option<u64> {
+    let items = &self.party_queue.items;
+    items
+      .get(position)
+      .filter(|item| item.uri == uri)
+      .or_else(|| items.iter().find(|item| item.uri == uri))
+      .map(|item| item.id)
+  }
+
   pub(crate) fn party_session(&self) -> Option<&PartySession> {
     self.party_session.as_ref()
   }
