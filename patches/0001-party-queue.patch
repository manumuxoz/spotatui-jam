   /// Move one native-queue item to index `to`; a no-op when out of range.
   pub(crate) fn move_queue_item(&mut self, uri: &str, from: usize, to: usize) {
+    if self.party_is_active() {
+      let items = &self.party_queue.items;
+      let Some(item) = items.get(from).filter(|item| item.uri == uri) else {
+        return;
+      };
+      if to >= items.len() {
+        return;
+      }
+      let id = item.id;
+      let after = if to == 0 {
+        None
+      } else if to > from {
+        items.get(to).map(|item| item.id)
+      } else {
+        items.get(to - 1).map(|item| item.id)
+      };
+      self.dispatch(IoEvent::PartyQueueCommand(
