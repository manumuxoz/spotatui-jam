--- /dev/null
+++ b/src/core/party/mod.rs
@@ -0,0 +1,14 @@
+//! Host-authoritative collaborative queue for Listening Party.
+//!
+//! The relay is deliberately dumb: the host owns the queue and broadcasts
+//! revisioned snapshots/patches. Guests hold a mirror and send intents. All
+//! validation and ordering happens here, in the host's process.
+
+pub mod queue;
+
+#[allow(unused_imports)]
+pub use queue::{
+  PartyMember, PartyMemberRole, PartyPlaybackMode, PartyQueue, PartyQueueConfig, PartyQueueError,
+  PartyQueueItem, PartyQueueMode, PartyQueueSnapshot, PartyTrack, PlayedItem, QueueAck,
+  QueueAction, QueueCommand, QueueOp, QueuePatch, SnapshotAssembler,
+};
diff --git a/src/core/party/queue.rs b/src/core/party/queue.rs
new file mode 100644
index 0000000..14cc83e
--- /dev/null
+++ b/src/core/party/queue.rs
@@ -0,0 +1,1323 @@
+//! Party-queue domain model.
+//!
+//! This module is deliberately frontend- and network-neutral: it owns the
+//! invariants, validation and replay rules. The host applies [`QueueAction`]s
+//! and broadcasts [`QueueOp`]s; a guest applies [`QueuePatch`]es or a chunked
+//! [`PartyQueueSnapshot`] and asks for a resync when a revision is missing.
+
+use std::collections::HashMap;
+
+use serde::{Deserialize, Serialize};
+
+use crate::core::plugin_api::TrackInfo;
+
+pub const DEFAULT_MAX_ITEMS: usize = 100;
+pub const DEFAULT_MAX_PER_GUEST: usize = 5;
+pub const DEFAULT_ADD_COOLDOWN_MS: u64 = 2_000;
+pub const MAX_TRACK_MS: u32 = 3_600_000;
+pub const HISTORY_LIMIT: usize = 50;
+
+/// Who may mutate the queue. This is independent of playback control.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PartyQueueMode {
+  HostOnly,
+  #[default]
+  GuestsAdd,
+  GuestsManage,
+}
+
+/// Who actually reproduces the audio.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PartyPlaybackMode {
+  #[default]
+  FollowHost,
+  HostOnly,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PartyMemberRole {
+  Host,
+  Guest,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PartyMember {
+  pub id: String,
+  pub name: String,
+  pub role: PartyMemberRole,
+}
+
+impl PartyMember {
+  pub fn host(name: impl Into<String>) -> Self {
+    Self {
+      id: "host".to_string(),
+      name: name.into(),
+      role: PartyMemberRole::Host,
+    }
+  }
+
+  pub fn guest(id: impl Into<String>, name: impl Into<String>) -> Self {
+    Self {
+      id: id.into(),
+      name: name.into(),
+      role: PartyMemberRole::Guest,
+    }
+  }
+
+  pub fn is_host(&self) -> bool {
+    self.role == PartyMemberRole::Host || self.id == "host"
+  }
+}
