+/// The host-authoritative queue, and the guest-side mirror (same shape).
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct PartyQueue {
+  pub revision: u64,
+  pub next_id: u64,
+  pub current: Option<PartyQueueItem>,
+  pub items: Vec<PartyQueueItem>,
+  pub history: Vec<PlayedItem>,
+  pub config: PartyQueueConfig,
+  pub members: Vec<PartyMember>,
+  #[serde(skip)]
+  last_add_ms: HashMap<String, u64>,
+}
+
+impl Default for PartyQueue {
+  fn default() -> Self {
+    Self::new(PartyQueueConfig::default())
+  }
+}
+
+impl PartyQueue {
+  pub fn new(config: PartyQueueConfig) -> Self {
+    Self {
+      revision: 0,
+      next_id: 1,
+      current: None,
+      items: Vec::new(),
+      history: Vec::new(),
+      config,
+      members: Vec::new(),
+      last_add_ms: HashMap::new(),
+    }
+  }
+
+  pub fn with_host(config: PartyQueueConfig, host: PartyMember) -> Self {
+    let mut queue = Self::new(config);
+    queue.members = vec![host];
+    queue
+  }
+
+  /// Adopt the host's current playback and native queue when a jam starts.
+  pub fn adopt(
+    &mut self,
+    host: &PartyMember,
+    current: Option<&TrackInfo>,
+    queued: &[TrackInfo],
+    now_ms: u64,
+  ) {
+    self.current = current.and_then(|track| {
+      PartyTrack::from_track_info(track, false)
+        .ok()
+        .map(|t| PartyQueueItem::from_track(t, self.take_id(), host, now_ms))
+    });
+    for track in queued {
+      if let Ok(track) = PartyTrack::from_track_info(track, false) {
+        let item = PartyQueueItem::from_track(track, self.take_id(), host, now_ms);
+        self.items.push(item);
+      }
+    }
+    self.revision = if self.current.is_some() || !self.items.is_empty() {
+      1
+    } else {
+      0
+    };
+  }
+
+  pub fn len(&self) -> usize {
+    self.items.len() + usize::from(self.current.is_some())
+  }
+
+  pub fn projected_tracks(&self) -> Vec<TrackInfo> {
+    self
+      .items
+      .iter()
+      .map(PartyQueueItem::to_track_info)
+      .collect()
+  }
+
+  pub fn set_members(&mut self, members: Vec<PartyMember>) {
+    self.members = members;
+  }
+
+  fn take_id(&mut self) -> u64 {
+    let id = self.next_id;
+    self.next_id = self.next_id.saturating_add(1);
+    id
+  }
+
+  fn member(&self, id: &str) -> Option<&PartyMember> {
+    self.members.iter().find(|member| member.id == id)
+  }
+
+  fn push_history(&mut self, item: PartyQueueItem, now_ms: u64, skipped: bool) {
+    self.history.push(PlayedItem {
+      item,
+      played_at_ms: now_ms,
+      skipped,
+    });
+    if self.history.len() > HISTORY_LIMIT {
+      let excess = self.history.len() - HISTORY_LIMIT;
+      self.history.drain(..excess);
+    }
+  }
+
+  /// Validate and apply a participant intent. Returns the ops to broadcast.
+  pub fn apply_action(
+    &mut self,
+    action: QueueAction,
+    member: &PartyMember,
+    now_ms: u64,
+  ) -> Result<Vec<QueueOp>, PartyQueueError> {
+    let is_host = member.is_host() || self.member(&member.id).is_some_and(PartyMember::is_host);
+    match action {
+      QueueAction::Add {
+        uri,
+        title,
+        artists,
+        duration_ms,
+      } => {
+        if !is_host && self.config.queue_mode == PartyQueueMode::HostOnly {
+          return Err(PartyQueueError::new(
+            "forbidden",
+            "Solo el host puede añadir tracks",
+          ));
+        }
+        let track = PartyTrack::from_track_info(
+          &TrackInfo {
+            uri: Some(uri),
+            name: title,
+            artists,
+            album: String::new(),
+            duration_ms: duration_ms as u64,
+            id: None,
+            album_id: None,
+            artist_refs: Vec::new(),
+            is_playable: true,
+            is_local: false,
+            track_number: 0,
+            explicit: false,
+            image_url: None,
+            release_date: None,
+            generated_name: None,
+          },
+          true,
+        )?;
+        if self.len() >= self.config.max_items {
+          return Err(PartyQueueError::new("queue_full", "La cola está llena"));
+        }
+        if !is_host {
+          let own = self
+            .items
+            .iter()
+            .filter(|item| item.added_by == member.id)
+            .count();
+          if own >= self.config.max_per_guest {
+            return Err(PartyQueueError::new(
+              "guest_limit",
+              "Has alcanzado tu límite de tracks",
+            ));
+          }
+          if let Some(last) = self.last_add_ms.get(&member.id) {
+            if now_ms.saturating_sub(*last) < self.config.add_cooldown_ms {
+              return Err(PartyQueueError::new(
+                "rate_limited",
+                "Espera un momento antes de añadir otro track",
+              ));
+            }
+          }
+        }
+        if self.config.dedupe
+          && self
+            .current
+            .iter()
+            .chain(self.items.iter())
+            .any(|item| item.uri == track.uri)
+        {
+          return Err(PartyQueueError::new(
+            "duplicate",
+            "Ese track ya está en la cola",
+          ));
+        }
+        let id = self.take_id();
+        let item = PartyQueueItem::from_track(track, id, member, now_ms);
+        self.items.push(item.clone());
+        self.last_add_ms.insert(member.id.clone(), now_ms);
+        self.revision = self.revision.saturating_add(1);
+        Ok(vec![QueueOp::Add { item }])
+      }
+      QueueAction::Remove { id } => {
+        let Some(index) = self.items.iter().position(|item| item.id == id) else {
+          return Err(PartyQueueError::new(
+            "unknown_item",
+            "Ese track ya no está en la cola",
+          ));
+        };
+        let item = &self.items[index];
+        let owns = item.added_by == member.id;
+        let allowed = is_host || (self.config.queue_mode == PartyQueueMode::GuestsManage && owns);
+        if !allowed {
+          return Err(PartyQueueError::new(
+            "forbidden",
+            "No puedes quitar ese track",
+          ));
+        }
+        self.items.remove(index);
+        self.revision = self.revision.saturating_add(1);
+        Ok(vec![QueueOp::Remove { id }])
+      }
+      QueueAction::Move { id, after } => {
+        if !is_host && self.config.queue_mode != PartyQueueMode::GuestsManage {
+          return Err(PartyQueueError::new(
+            "forbidden",
+            "No puedes reordenar la cola",
+          ));
+        }
+        let Some(from) = self.items.iter().position(|item| item.id == id) else {
+          return Err(PartyQueueError::new(
+            "unknown_item",
+            "Ese track ya no está en la cola",
+          ));
+        };
+        if after == Some(id) {
+          return Err(PartyQueueError::new(
+            "stale_item",
+            "No puedes mover un track tras sí mismo",
+          ));
+        }
+        let target = match after {
+          Some(after) => {
+            let Some(pos) = self.items.iter().position(|item| item.id == after) else {
+              return Err(PartyQueueError::new(
+                "stale_item",
+                "El track de referencia ya no existe",
+              ));
+            };
+            if pos < from {
+              pos + 1
+            } else {
+              pos
+            }
+          }
+          None => 0,
+        };
+        let item = self.items.remove(from);
+        let target = target.min(self.items.len());
+        self.items.insert(target, item);
+        self.revision = self.revision.saturating_add(1);
+        Ok(vec![QueueOp::Move { id, after }])
+      }
+      QueueAction::Clear => {
+        if !is_host {
+          return Err(PartyQueueError::new(
+            "forbidden",
+            "Solo el host puede vaciar la cola",
+          ));
+        }
+        self.items.clear();
+        self.revision = self.revision.saturating_add(1);
+        Ok(vec![QueueOp::Clear])
+      }
+      QueueAction::PlayNow { id } => {
+        if !is_host {
+          return Err(PartyQueueError::new(
+            "forbidden",
+            "Solo el host puede poner un track ahora",
+          ));
+        }
+        let Some(index) = self.items.iter().position(|item| item.id == id) else {
+          return Err(PartyQueueError::new(
+            "unknown_item",
+            "Ese track ya no está en la cola",
+          ));
+        };
+        let item = self.items.remove(index);
+        let played_id = self.current.as_ref().map(|current| current.id);
+        if let Some(current) = self.current.take() {
+          self.push_history(current, now_ms, true);
+        }
+        self.current = Some(item.clone());
+        self.revision = self.revision.saturating_add(1);
+        Ok(vec![QueueOp::SetCurrent {
+          current: item,
+          played_id,
+          skipped: true,
+        }])
+      }
+      QueueAction::Vote { .. } => Err(PartyQueueError::new(
+        "unsupported",
+        "La votación todavía no está disponible",
+      )),
+    }
+  }
+
+  /// Guest-side replay. Returns `StaleRev` when a patch is missing.
+  pub fn apply_patch(&mut self, patch: &QueuePatch) -> Result<(), PartyQueueError> {
+    if patch.revision != self.revision.saturating_add(1) {
+      return Err(PartyQueueError::new(
+        "stale_rev",
+        "La revisión no es contigua; pide un snapshot",
+      ));
+    }
+    for op in &patch.ops {
+      match op {
+        QueueOp::Add { item } => {
+          if item.id != 0 && self.items.iter().all(|existing| existing.id != item.id) {
+            self.items.push(item.clone());
+          }
+        }
+        QueueOp::Remove { id } => {
+          self.items.retain(|item| item.id != *id);
+        }
+        QueueOp::Move { id, after } => {
+          if let Some(from) = self.items.iter().position(|item| item.id == *id) {
+            let item = self.items.remove(from);
+            let target = match after {
+              Some(after) => self
+                .items
+                .iter()
+                .position(|item| item.id == *after)
+                .map(|pos| pos + 1)
+                .unwrap_or(self.items.len()),
+              None => 0,
+            };
+            self.items.insert(target.min(self.items.len()), item);
+          }
+        }
+        QueueOp::Clear => self.items.clear(),
+        QueueOp::Advance {
+          current,
+          played_id,
+          skipped,
+        } => {
+          if let Some(old) = self.current.take() {
+            self.push_history(old, current.added_at_ms, *skipped);
+          }
+          self
+            .items
+            .retain(|item| item.id != *played_id && item.id != current.id);
+          self.current = Some(current.clone());
+        }
+        QueueOp::SetCurrent {
+          current,
+          played_id,
+          skipped,
+        } => {
+          if let Some(old) = self.current.take() {
+            self.push_history(old, current.added_at_ms, *skipped);
+          }
+          if let Some(played_id) = played_id {
+            self.items.retain(|item| item.id != *played_id);
+          }
+          self.items.retain(|item| item.id != current.id);
+          self.current = Some(current.clone());
+        }
+        QueueOp::ClearCurrent => {
+          if let Some(old) = self.current.take() {
+            self.push_history(old, 0, true);
+          }
+        }
+        QueueOp::Reset { current, items } => {
+          self.current = current.clone();
+          self.items = items.clone();
+        }
+      }
+    }
+    self.revision = patch.revision;
+    Ok(())
+  }
+
+  /// Replace the mirror with an assembled snapshot.
+  pub fn apply_snapshot(&mut self, snapshot: &PartyQueueSnapshot) {
+    if snapshot.revision < self.revision {
+      return;
+    }
+    self.revision = snapshot.revision;
+    self.current = snapshot.current.clone();
+    self.items = snapshot.items.clone();
+    if !snapshot.history_tail.is_empty() {
+      self.history = snapshot.history_tail.clone();
+    }
+  }
+
+  /// Detect a playback transition and return the op that records it.
+  ///
+  /// `uri` is the track the host is actually playing. When it matches the head
+  /// of the queue, the current item moves to history and the head becomes
+  /// current. A track outside the queue clears `current` (the host is playing
+  /// a context, not the jam queue) but leaves the queued items intact.
+  pub fn observe_playback(&mut self, uri: &str, now_ms: u64) -> Option<QueueOp> {
+    if self.current.as_ref().is_some_and(|item| item.uri == uri) {
+      return None;
+    }
+    if let Some(index) = self.items.iter().position(|item| item.uri == uri) {
+      let item = self.items.remove(index);
+      let played_id = self.current.as_ref().map(|current| current.id);
+      if let Some(current) = self.current.take() {
+        self.push_history(current, now_ms, false);
+      }
+      self.current = Some(item.clone());
+      self.revision = self.revision.saturating_add(1);
+      return Some(QueueOp::Advance {
+        current: item,
+        played_id: played_id.unwrap_or(0),
+        skipped: false,
+      });
+    }
+    if self.current.is_some() {
+      self.current = None;
+      self.revision = self.revision.saturating_add(1);
+      return Some(QueueOp::ClearCurrent);
+    }
+    None
+  }
+
+  pub fn snapshot(&self, snapshot_id: &str, to: Option<String>) -> PartyQueueSnapshot {
+    PartyQueueSnapshot {
+      revision: self.revision,
+      snapshot_id: snapshot_id.to_string(),
+      chunk: 0,
+      chunks: 1,
+      to,
+      current: self.current.clone(),
+      items: self.items.clone(),
+      history_tail: self
+        .history
+        .iter()
+        .rev()
+        .take(20)
+        .cloned()
+        .collect::<Vec<_>>()
+        .into_iter()
+        .rev()
+        .collect(),
+    }
+  }
+}
+
+/// Collects chunked snapshots and returns the full one when complete.
+#[derive(Default)]
+pub struct SnapshotAssembler {
+  snapshot_id: Option<String>,
+  revision: u64,
+  chunks: u16,
+  current: Option<PartyQueueItem>,
+  items: Vec<Option<Vec<PartyQueueItem>>>,
+  history_tail: Vec<PlayedItem>,
+}
+
+impl SnapshotAssembler {
+  pub fn push(&mut self, snapshot: &PartyQueueSnapshot) -> Option<PartyQueueSnapshot> {
+    if snapshot.chunks == 0 || snapshot.chunk >= snapshot.chunks || snapshot.chunks > 50 {
+      return None;
+    }
+    if self.snapshot_id.as_deref() != Some(snapshot.snapshot_id.as_str())
+      || self.revision != snapshot.revision
+    {
+      self.snapshot_id = Some(snapshot.snapshot_id.clone());
+      self.revision = snapshot.revision;
+      self.chunks = snapshot.chunks;
+      self.current = snapshot.current.clone();
+      self.items = vec![None; snapshot.chunks as usize];
+      self.history_tail = snapshot.history_tail.clone();
+    }
+    let index = snapshot.chunk as usize;
+    self.items[index] = Some(snapshot.items.clone());
+    if self.items.iter().all(Option::is_some) {
+      let items = self
+        .items
+        .iter()
+        .flat_map(|chunk| chunk.clone().unwrap_or_default())
+        .collect();
+      Some(PartyQueueSnapshot {
+        revision: snapshot.revision,
+        snapshot_id: snapshot.snapshot_id.clone(),
+        chunk: 0,
+        chunks: 1,
+        to: snapshot.to.clone(),
+        current: self.current.clone(),
+        items,
+        history_tail: self.history_tail.clone(),
+      })
+    } else {
+      None
+    }
+  }
+}
