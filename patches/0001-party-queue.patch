+  #[test]
+  fn random_patch_sequences_converge() {
+    // A tiny deterministic LCG keeps this test dependency-free while still
+    // exercising arbitrary add/remove/move/replay sequences.
+    let mut state = 0x1234_5678_9abc_def0u64;
+    let mut next = || {
+      state = state
+        .wrapping_mul(6364136223846793005)
+        .wrapping_add(1442695040888963407);
+      state
+    };
+    let mut host_queue = PartyQueue::with_host(PartyQueueConfig::default(), host());
+    let mut mirror = PartyQueue::with_host(PartyQueueConfig::default(), host());
+    for i in 0..200 {
+      let id = next() % 1_000_000;
+      let uri = format!("spotify:track:{:022}", id % 1_000_000_000_000);
+      let ops = match next() % 4 {
+        0 => host_queue.apply_action(add(&uri, &format!("T{i}")), &host(), NOW + i),
+        1 => host_queue.apply_action(
+          QueueAction::Remove {
+            id: host_queue.items.first().map(|item| item.id).unwrap_or(0),
+          },
+          &host(),
+          NOW + i,
+        ),
+        2 => host_queue.apply_action(
+          QueueAction::Move {
+            id: host_queue.items.first().map(|item| item.id).unwrap_or(0),
+            after: None,
+          },
+          &host(),
+          NOW + i,
+        ),
+        _ => Ok(vec![]),
+      };
+      if let Ok(ops) = ops {
+        if !ops.is_empty() {
+          mirror
+            .apply_patch(&QueuePatch {
+              revision: host_queue.revision,
+              ops,
+            })
+            .unwrap();
+        }
+      }
+    }
+    assert_eq!(mirror.items, host_queue.items);
+    assert_eq!(mirror.revision, host_queue.revision);
+  }
+}
