+/// The wire-safe subset of a track. It never carries image URLs or full
+/// `TrackInfo`, keeping snapshots small enough for the 4 KB relay limit.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PartyTrack {
+  pub uri: String,
+  pub title: String,
+  pub artists: Vec<String>,
+  pub duration_ms: u32,
+}
+
+impl PartyTrack {
+  pub fn from_track_info(track: &TrackInfo, strict: bool) -> Result<Self, PartyQueueError> {
+    let uri = track
+      .uri
+      .clone()
+      .ok_or_else(|| PartyQueueError::new("invalid_uri", "El track no tiene URI de Spotify"))?;
+    if !is_spotify_track_uri(&uri) {
+      return Err(PartyQueueError::new(
+        "invalid_uri",
+        "Solo se admiten tracks `spotify:track:`",
+      ));
+    }
+    let title = sanitize(&track.name, 200);
+    if title.is_empty() {
+      return Err(PartyQueueError::new(
+        "invalid_metadata",
+        "El track no tiene título",
+      ));
+    }
+    let artists: Vec<String> = track
+      .artists
+      .iter()
+      .map(|a| sanitize(a, 200))
+      .filter(|a| !a.is_empty())
+      .take(8)
+      .collect();
+    if artists.is_empty() {
+      return Err(PartyQueueError::new(
+        "invalid_metadata",
+        "El track no tiene artista",
+      ));
+    }
+    let duration_ms = track.duration_ms.min(u32::MAX as u64) as u32;
+    if strict && (duration_ms == 0 || duration_ms > MAX_TRACK_MS) {
+      return Err(PartyQueueError::new(
+        "invalid_metadata",
+        "Duración fuera de rango",
+      ));
+    }
+    Ok(Self {
+      uri,
+      title,
+      artists,
+      duration_ms,
+    })
+  }
+}
